link rel="stylesheet" href="/css/style.css">

<header>
  <h1>StudyFlow</h1>

  <nav>
    <a href="/dashboard">Dashboard</a>
    <a href="/disciplinas">Disciplinas</a>
    <a href="/tarefas">Tarefas</a>
  </nav>
</header>

<main>
  <% if (mensagemSucesso) { %>
    <p class="alert alert-success"><%= mensagemSucesso %></p>
  <% } %>

  <% if (mensagemErro) { %>
    <p class="alert alert-error"><%= mensagemErro %></p>
  <% } %>
  <section class="card">
    <h2>Bem-vindo</h2>
    <p>Olá, <%= usuario.nome %>!</p>
  </section>

  <section class="dashboard-cards">

    <article class="card">
      <h3>Disciplinas</h3>
      <p><%= totalDisciplinas %></p>
    </article>

    <article class="card">
      <h3>Total de tarefas</h3>
      <p><%= resumoTarefas.total  0 %></p>
    </article>

    <article class="card">
      <h3>Pendentes</h3>
      <p><%= resumoTarefas.pendentes 
 0 %></p>
    </article>

    <article class="card">
      <h3>Em andamento</h3>
      <p><%= resumoTarefas.em_andamento  0 %></p>
    </article>

    <article class="card">
      <h3>Concluídas</h3>
      <p><%= resumoTarefas.concluidas  0 %></p>
    </article>

  </section>

  <section class="card">

    <h2>Próximas Entregas</h2>

    <% if (proximasEntregas.length === 0) { %>

      <p>Nenhuma entrega cadastrada.</p>

    <% } else { %>

      <ul>

        <% proximasEntregas.forEach(tarefa => { %>

          <li>
            <strong><%= tarefa.titulo %></strong>

            (<%= tarefa.disciplina_nome %>)

            -

            <%= tarefa.data_entrega.toLocaleDateString("pt-BR") %>
          </li>

        <% }) %>

      </ul>

    <% } %>

  </section>

  <form action="/logout" method="POST">
    <button type="submit">Sair</button>
  </form>

</main>

<footer>
  <p>StudyFlow © 2026</p>
</footer>