<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Nova Tarefa - StudyFlow</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/css/style.css">
</head>

<body class="dashboard-body">

  <div class="dashboard-layout">

    <aside class="sidebar">
      <div class="sidebar-header">
        <h2>Study<span class="sub">Flow</span></h2>
      </div>

      <nav class="sidebar-nav">
        <a href="/dashboard">Dashboard</a>
        <a href="/disciplinas">Disciplinas</a>
        <a href="/tarefas" class="active">Tarefas</a>
      </nav>

      <div class="sidebar-footer">
        <form action="/logout" method="POST">
          <button type="submit" class="btn-logout">
            Sair da conta
          </button>
        </form>
      </div>
    </aside>

    <main class="main-content">

      <section class="welcome-banner card-shadow">
        <div class="welcome-text">
          <h1>Nova Tarefa</h1>
          <p>Cadastre uma nova atividade acadêmica.</p>
        </div>
      </section>

      <section class="tasks-section card-shadow">

        <form action="/tarefas" method="POST" data-validar>

          <label>Título</label>
          <input
            type="text"
            name="titulo"
            placeholder="Digite o título da tarefa"
            required
          >

          <label>Descrição</label>
          <textarea
            name="descricao"
            rows="4"
            placeholder="Descrição da tarefa"
          ></textarea>

          <label>Disciplina</label>
          <select name="disciplinaId" required>
            <option value="">Selecione uma disciplina</option>

            <% disciplinas.forEach(disciplina => { %>
              <option value="<%= disciplina.id %>">
                <%= disciplina.nome %>
              </option>
            <% }) %>

          </select>

          <label>Prioridade</label>
          <select name="prioridade">
            <option value="Baixa">Baixa</option>
            <option value="Média" selected>Média</option>
            <option value="Alta">Alta</option>
          </select>

          <label>Data de Entrega</label>
          <input type="date" name="dataEntrega">

          <button type="submit" class="btn-primary">
            Salvar Tarefa
          </button>

        </form>

      </section>

      <footer class="dashboard-footer">
        <p>StudyFlow © 2026</p>
      </footer>

    </main>

  </div>

  <script src="/js/validacao.js"></script>

</body>
</html>