<link rel="stylesheet" href="/css/style.css">

<header>
  <h1>StudyFlow</h1>

  <nav>
    <a href="/dashboard">Dashboard</a>
    <a href="/disciplinas">Disciplinas</a>
    <a href="/tarefas">Tarefas</a>
  </nav>
</header>

<main>
  <% if (mensagemSucesso) { %>
  <p class="alert alert-success"><%= mensagemSucesso %></p>
  <% } %>

  <% if (mensagemErro) { %>
    <p class="alert alert-error"><%= mensagemErro %></p>
  <% } %>
  <section class="card">
    <h2>Minhas tarefas</h2>
    <a href="/tarefas/nova">Nova tarefa</a>
  </section>

  <section class="card">
    <table>
      <thead>
        <tr>
          <th>Título</th>
          <th>Disciplina</th>
          <th>Status</th>
          <th>Prioridade</th>
          <th>Entrega</th>
          <th>Ações</th>
        </tr>
      </thead>

      <tbody>
        <% tarefas.forEach(tarefa => { %>
          <tr>
            <td><%= tarefa.titulo %></td>
            <td><%= tarefa.disciplina_nome %></td>
            <td><%= tarefa.status %></td>
            <td><%= tarefa.prioridade %></td>
            <td><%= tarefa.data_entrega ? tarefa.data_entrega.toLocaleDateString("pt-BR") : "Sem data" %></td>
            <td>
              <a href="/tarefas/editar/<%= tarefa.id %>">Editar</a>

              <form action="/tarefas/concluir/<%= tarefa.id %>" method="POST">
                <button type="submit">Concluir</button>
              </form>

              <form action="/tarefas/excluir/<%= tarefa.id %>" method="POST">
                <button type="submit">Excluir</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </section>
</main>

<footer>
  <p>StudyFlow © 2026</p>
</footer>