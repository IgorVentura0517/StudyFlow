<link rel="stylesheet" href="/css/style.css">
<h1>Minhas tarefas</h1>

<a href="/tarefas/nova">Nova tarefa</a>

<ul>
  <% tarefas.forEach(tarefa => { %>
    <li>
      <strong><%= tarefa.titulo %></strong>
      <p><%= tarefa.descricao %></p>
      <p>Disciplina: <%= tarefa.disciplina_nome %></p>
      <p>Status: <%= tarefa.status %></p>
      <p>Prioridade: <%= tarefa.prioridade %></p>
      <p>Entrega: <%= tarefa.data_entrega %></p>

      <a href="/tarefas/editar/<%= tarefa.id %>">Editar</a>

      <form action="/tarefas/concluir/<%= tarefa.id %>" method="POST">
        <button type="submit">Concluir</button>
      </form>

      <form action="/tarefas/excluir/<%= tarefa.id %>" method="POST">
        <button type="submit">Excluir</button>
      </form>
    </li>
  <% }) %>
</ul>

<a href="/dashboard">Voltar ao dashboard</a>