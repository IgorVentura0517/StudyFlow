<link rel="stylesheet" href="/css/style.css">

<header>
  <h1>StudyFlow</h1>

  <nav>
    <a href="/dashboard">Dashboard</a>
    <a href="/disciplinas">Disciplinas</a>
    <a href="/tarefas">Tarefas</a>
  </nav>
</header>

<main>
  <section class="card">
    <h2>Editar tarefa</h2>

    <form action="/tarefas/editar/<%= tarefa.id %>" method="POST" data-validar>
      <label>Título</label>
      <input type="text" name="titulo" value="<%= tarefa.titulo %>" required>

      <label>Descrição</label>
      <textarea name="descricao"><%= tarefa.descricao %></textarea>

      <label>Disciplina</label>
      <select name="disciplinaId" required>
        <% disciplinas.forEach(disciplina => { %>
          <option value="<%= disciplina.id %>" <%= disciplina.id === tarefa.disciplina_id ? "selected" : "" %>>
            <%= disciplina.nome %>
          </option>
        <% }) %>
      </select>

      <label>Status</label>
      <select name="status" required>
        <option value="Pendente" <%= tarefa.status === "Pendente" ? "selected" : "" %>>Pendente</option>
        <option value="Em andamento" <%= tarefa.status === "Em andamento" ? "selected" : "" %>>Em andamento</option>
        <option value="Concluída" <%= tarefa.status === "Concluída" ? "selected" : "" %>>Concluída</option>
      </select>

      <label>Prioridade</label>
      <select name="prioridade" required>
        <option value="Baixa" <%= tarefa.prioridade === "Baixa" ? "selected" : "" %>>Baixa</option>
        <option value="Média" <%= tarefa.prioridade === "Média" ? "selected" : "" %>>Média</option>
        <option value="Alta" <%= tarefa.prioridade === "Alta" ? "selected" : "" %>>Alta</option>
      </select>

      <label>Data de entrega</label>
      <input type="date" name="dataEntrega" value="<%= tarefa.data_entrega ? tarefa.data_entrega.toISOString().split('T')[0] : '' %>">

      <button type="submit">Atualizar</button>
    </form>

    <a href="/tarefas">Voltar</a>
  </section>
</main>

<footer>
  <p>StudyFlow © 2026</p>
</footer>

<script src="/js/validacao.js"></script>