<link rel="stylesheet" href="/css/style.css">
<h1>Editar disciplina</h1>

<form action="/disciplinas/editar/<%= disciplina.id %>" method="POST" data-validar>
  <input type="text" name="nome" value="<%= disciplina.nome %>" required>
  <textarea name="descricao"><%= disciplina.descricao %></textarea>

  <button type="submit">Atualizar</button>
</form>

<a href="/disciplinas">Voltar</a>

<script src="/js/validacao.js"></script>