<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Disciplinas - StudyFlow</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/css/style.css">
</head>

<body class="dashboard-body">

  <div class="dashboard-layout">

    <aside class="sidebar">
      <div class="sidebar-header">
        <h2>Study<span class="sub">Flow</span></h2>
      </div>

      <nav class="sidebar-nav">
        <a href="/dashboard">Dashboard</a>
        <a href="/disciplinas" class="active">Disciplinas</a>
        <a href="/tarefas">Tarefas</a>
      </nav>

      <div class="sidebar-footer">
        <form action="/logout" method="POST">
          <button type="submit" class="btn-logout">Sair da conta</button>
        </form>
      </div>
    </aside>

    <main class="main-content">

      <% if (typeof mensagemSucesso !== 'undefined' && mensagemSucesso) { %>
        <div class="alert alert-success"><%= mensagemSucesso %></div>
      <% } %>

      <% if (typeof mensagemErro !== 'undefined' && mensagemErro) { %>
        <div class="alert alert-error"><%= mensagemErro %></div>
      <% } %>

      <section class="welcome-banner card-shadow">
        <div class="welcome-text">
          <h1>Minhas Disciplinas</h1>
          <p>Gerencie suas disciplinas e acompanhe seu progresso.</p>
        </div>
      </section>

      <section class="tasks-section card-shadow">
        <div class="section-header">
          <h2>Lista de disciplinas</h2>
          <a href="/disciplinas/nova" class="btn-new">+ Nova disciplina</a>
        </div>

        <% if (disciplinas.length === 0) { %>
          <div class="empty-state">
            <p>Nenhuma disciplina cadastrada ainda.</p>
          </div>
        <% } else { %>
          <div class="table-wrapper">
            <table>
              <thead>
                <tr>
                  <th>Nome</th>
                  <th>Descrição</th>
                  <th>Ações</th>
                </tr>
              </thead>

              <tbody>
                <% disciplinas.forEach(disciplina => { %>
                  <tr>
                    <td><%= disciplina.nome %></td>
                    <td><%= disciplina.descricao || "Sem descrição" %></td>
                    <td class="actions">
                      <a href="/disciplinas/editar/<%= disciplina.id %>" class="btn-edit">Editar</a>

                      <form action="/disciplinas/excluir/<%= disciplina.id %>" method="POST">
                        <button type="submit" class="btn-delete">Excluir</button>
                      </form>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </section>

      <footer class="dashboard-footer">
        <p>StudyFlow © 2026</p>
      </footer>

    </main>

  </div>

</body>
</html>