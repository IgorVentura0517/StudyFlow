<link rel="stylesheet" href="/css/style.css">

<header>
  <h1>StudyFlow</h1>

  <nav>
    <a href="/dashboard">Dashboard</a>
    <a href="/disciplinas">Disciplinas</a>
    <a href="/tarefas">Tarefas</a>
  </nav>
</header>

<main>
  <section class="card">
    <h2>Minhas disciplinas</h2>
    <a href="/disciplinas/nova">Nova disciplina</a>
  </section>

  <section class="card">
    <table>
      <thead>
        <tr>
          <th>Nome</th>
          <th>Descrição</th>
          <th>Ações</th>
        </tr>
      </thead>

      <tbody>
        <% disciplinas.forEach(disciplina => { %>
          <tr>
            <td><%= disciplina.nome %></td>
            <td><%= disciplina.descricao || "Sem descrição" %></td>
            <td>
              <a href="/disciplinas/editar/<%= disciplina.id %>">Editar</a>

              <form action="/disciplinas/excluir/<%= disciplina.id %>" method="POST">
                <button type="submit">Excluir</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </section>
</main>

<footer>
  <p>StudyFlow © 2026</p>
</footer>